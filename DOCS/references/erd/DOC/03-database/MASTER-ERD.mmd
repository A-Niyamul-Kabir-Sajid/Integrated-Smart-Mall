        uuid shop_id FK "NULL"
        uuid shop_product_id FK "NULL"
    }
    DOCUMENT_REVISION {
        uuid revision_id PK "NN"
        uuid document_id FK "NN"
    }
    KNOWLEDGE_CHUNK {
        uuid chunk_id PK "NN"
        uuid revision_id FK "NN"
    }
    CHUNK_EMBEDDING {
        uuid chunk_id PK, FK "NN"
        varchar(120) model_key PK "NN"
    }
    MESSAGE_CITATION {
        uuid message_id PK, FK "NN"
        uuid chunk_id PK, FK "NN"
    }
    MESSAGE_RECOMMENDATION {
        uuid message_id PK, FK "NN"
        uuid shop_product_id PK, FK "NN"
    }
    METRIC_DEFINITION {
        varchar(80) metric_code PK "NN"
    }
    SHOP_METRIC_SNAPSHOT {
        uuid snapshot_id PK "NN"
        uuid shop_id FK "NN"
        varchar(80) metric_code FK "NN"
    }
    REPORT_RUN {
        uuid report_run_id PK "NN"
        uuid mall_id FK "NN"
        uuid requested_by_user_id FK "NULL"
    }
    REPORT_SHOP_SCOPE {
        uuid report_run_id PK, FK "NN"
        uuid shop_id PK, FK "NN"
    }
    REPORT_METRIC_SNAPSHOT {
        uuid report_run_id PK, FK "NN"
        uuid snapshot_id PK, FK "NN"
    }
    REPORT_ARTIFACT {
        uuid report_artifact_id PK "NN"
        uuid report_run_id FK "NN"
    }
    FORECAST_RUN {
        uuid forecast_run_id PK "NN"
        uuid shop_id FK "NN"
        varchar(80) metric_code FK "NN"
    }
    FORECAST_TRAINING_SNAPSHOT {
        uuid forecast_run_id PK, FK "NN"
        uuid snapshot_id PK, FK "NN"
    }
    FORECAST_POINT {
        uuid forecast_point_id PK "NN"
        uuid forecast_run_id FK "NN"
    }
    REPORT_FORECAST {
        uuid report_run_id PK, FK "NN"
        uuid forecast_run_id PK, FK "NN"
    }
