        uuid shop_id FK "NN"
        uuid shop_product_id FK "NULL"
    }
    REVIEW_VERIFICATION {
        uuid review_id PK, FK "NN"
        uuid verification_token_id FK, UK "NN"
    }
    REVIEW_REPLY {
        uuid review_reply_id PK "NN"
        uuid review_id FK "NN"
        uuid author_user_id FK "NN"
    }
    REVIEW_REPORT {
        uuid review_report_id PK "NN"
        uuid review_id FK "NN"
        uuid reporter_user_id FK "NN"
    }
    MODERATION_ACTION {
        uuid moderation_action_id PK "NN"
        uuid review_id FK "NN"
        uuid review_report_id FK "NULL"
        uuid actor_user_id FK "NN"
    }
    USER_PREFERENCE {
        uuid user_id PK, FK "NN"
        uuid default_mall_id FK "NULL"
    }
    FAVOURITE_SHOP {
        uuid user_id PK, FK "NN"
        uuid shop_id PK, FK "NN"
    }
    FAVOURITE_PRODUCT {
        uuid user_id PK, FK "NN"
        uuid shop_product_id PK, FK "NN"
    }
    CONVERSATION {
        uuid conversation_id PK "NN"
        uuid mall_id FK "NN"
        uuid user_id FK "NULL"
    }
    CHAT_MESSAGE {
        uuid message_id PK "NN"
