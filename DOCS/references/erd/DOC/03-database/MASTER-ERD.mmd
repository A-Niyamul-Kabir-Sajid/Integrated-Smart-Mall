        uuid node_id FK "NN"
        uuid incoming_edge_id FK "NULL"
    }
    PURCHASE {
        uuid purchase_id PK "NN"
        uuid shop_id FK "NN"
        uuid buyer_user_id FK "NULL"
    }
    PURCHASE_ITEM {
        uuid purchase_item_id PK "NN"
