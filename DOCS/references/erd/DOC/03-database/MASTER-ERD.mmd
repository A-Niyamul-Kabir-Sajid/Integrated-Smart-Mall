erDiagram
    direction TB
    %% Master ERD — all modules, keys only
    %% NN = required; NULL = nullable. Composite unique/check rules are in the module documents.
    APP_USER {
        uuid user_id PK "NN"
    }
    ROLE {
        uuid role_id PK "NN"
    }
    USER_ROLE {
        uuid user_id PK, FK "NN"
        uuid role_id PK, FK "NN"
    }
    MALL_MEMBERSHIP {
        uuid mall_membership_id PK "NN"
        uuid user_id FK "NN"
        uuid mall_id FK "NN"
        uuid role_id FK "NN"
    }
    SHOP_MEMBERSHIP {
        uuid shop_membership_id PK "NN"
        uuid user_id FK "NN"
        uuid shop_id FK "NN"
        uuid role_id FK "NN"
    }
    AUTH_SESSION {
        uuid session_id PK "NN"
        uuid user_id FK "NN"
    }
    MALL {
        uuid mall_id PK "NN"
    }
    FLOOR {
        uuid floor_id PK "NN"
        uuid mall_id FK "NN"
    }
    SHOP_CATEGORY {
        uuid shop_category_id PK "NN"
        uuid parent_category_id FK "NULL"
    }
    SHOP {
        uuid shop_id PK "NN"
        uuid mall_id FK "NN"
        uuid shop_category_id FK "NN"
    }
    SHOP_UNIT {
        uuid shop_unit_id PK "NN"
        uuid shop_id FK "NN"
        uuid floor_id FK "NN"
    }
    SHOP_OPENING_HOUR {
        uuid shop_id PK, FK "NN"
        smallint weekday PK "NN"
        smallint interval_no PK "NN"
    }
    FACILITY {
        uuid facility_id PK "NN"
        uuid floor_id FK "NN"
    }
    PRODUCT_CATEGORY {
        uuid product_category_id PK "NN"
        uuid parent_category_id FK "NULL"
    }
    PRODUCT {
        uuid product_id PK "NN"
        uuid product_category_id FK "NN"
    }
    PRODUCT_VARIANT {
        uuid variant_id PK "NN"
        uuid product_id FK "NN"
    }
    SHOP_PRODUCT {
        uuid shop_product_id PK "NN"
        uuid shop_id FK "NN"
        uuid variant_id FK "NN"
    }
    PRODUCT_IMAGE {
        uuid product_image_id PK "NN"
        uuid product_id FK "NN"
    }
    INVENTORY_BALANCE {
        uuid shop_product_id PK, FK "NN"
    }
    MAP_VERSION {
        uuid map_version_id PK "NN"
        uuid mall_id FK "NN"
    }
    FLOOR_MAP {
        uuid floor_map_id PK "NN"
        uuid map_version_id FK "NN"
        uuid floor_id FK "NN"
    }
    NAVIGATION_NODE {
        uuid node_id PK "NN"
        uuid map_version_id FK "NN"
        uuid floor_id FK "NN"
    }
    VERTICAL_CONNECTOR {
        uuid connector_id PK "NN"
        uuid mall_id FK "NN"
    }
    CONNECTOR_STOP {
        uuid connector_stop_id PK "NN"
        uuid connector_id FK "NN"
        uuid map_version_id FK "NN"
        uuid floor_id FK "NN"
        uuid node_id FK "NN"
    }
    NAVIGATION_EDGE {
        uuid edge_id PK "NN"
        uuid map_version_id FK "NN"
        uuid from_node_id FK "NN"
        uuid to_node_id FK "NN"
        uuid connector_id FK "NULL"
    }
    QR_CHECKPOINT {
        uuid checkpoint_id PK "NN"
        uuid mall_id FK "NN"
    }
    CHECKPOINT_ANCHOR {
        uuid checkpoint_id PK, FK "NN"
        uuid map_version_id PK, FK "NN"
        uuid node_id FK "NN"
    }
    SHOP_ENTRANCE {
        uuid shop_entrance_id PK "NN"
        uuid shop_unit_id FK "NN"
        uuid map_version_id FK "NN"
        uuid node_id FK "NN"
    }
    FACILITY_ANCHOR {
